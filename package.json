{
  "name": "muesli",
  "version": "0.1.0",
  "description": "Local meeting notes",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/providers.test.js && node test/mcp.test.js",
    "test:providers": "node test/providers.test.js",
    "test:mcp": "node test/mcp.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "keywords": [],
  "author": "Tyler Phipps",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.muesli.notes",
    "productName": "Muesli",
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-res/${os}",
        "to": "."
      }
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Muesli records your microphone during meetings you start.",
        "NSAudioCaptureUsageDescription": "Muesli records the other side of the call from system audio.",
        "NSScreenCaptureUsageDescription": "macOS routes system audio through screen capture. Muesli keeps the audio only and never records your screen."
      },
      "icon": "src/icons/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "src/icons/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Muesli-Setup-${version}.exe"
    },
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ]
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8"
  }
}
